{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [
        ".css",
        ".html",
        ".js",
        ".json",
        ".jsonc",
        ".jsx",
        ".md",
        ".scss",
        ".ts",
        ".tsx",
        ".yaml",
        ".yml",
        ".svg"
      ]
    },
    "yq": {
      "command": ["yq", "-i", "-P", "sort_keys(..)", "$FILE"],
      "extensions": [".yaml", ".yml"]
    }
  }
}
