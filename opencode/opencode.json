{
  "$schema": "https://opencode.ai/v2/config.json",
  "agents": {
    "raw": {
      "description": "Raw model, MCP tools only",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "execute",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "*_*",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "external_directory",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "plan_enter",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "plan_exit",
          "effect": "deny",
          "resource": "*"
        }
      ],
      "system": " "
    }
  },
  "formatter": {
    "json": {
      "command": [
        "sh",
        "-c",
        "jq --sort-keys . \"$1\" > \"$1.tmp\" && mv \"$1.tmp\" \"$1\"",
        "sh",
        "$FILE"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "prettier": {
      "command": [
        "prettier",
        "--write",
        "$FILE"
      ],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [
        ".css",
        ".html",
        ".js",
        ".json",
        ".jsonc",
        ".jsx",
        ".md",
        ".scss",
        ".ts",
        ".tsx",
        ".svg"
      ]
    },
    "stylua": {
      "command": [
        "stylua",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "yq": {
      "command": [
        "yq",
        "-i",
        "-P",
        "--yaml-compact-seq-indent",
        "sort_keys(..)",
        "$FILE"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh-actions": {
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        },
        "oauth": false,
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/x/actions"
      },
      "linear": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env.*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*.env.example"
    }
  ]
}
