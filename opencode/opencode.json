{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "json": {
      "command": [
        "sh",
        "-c",
        "jq --sort-keys . \"$1\" > \"$1.tmp\" && mv \"$1.tmp\" \"$1\"",
        "sh",
        "$FILE"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "prettier": {
      "command": [
        "prettier",
        "--write",
        "$FILE"
      ],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [
        ".css",
        ".html",
        ".js",
        ".json",
        ".jsonc",
        ".jsx",
        ".md",
        ".scss",
        ".ts",
        ".tsx",
        ".svg"
      ]
    },
    "stylua": {
      "command": [
        "stylua",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "yq": {
      "command": [
        "yq",
        "-i",
        "-P",
        "--yaml-compact-seq-indent",
        "sort_keys(..)",
        "$FILE"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh-actions": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/x/actions"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
