{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "json": {
      "command": [
        "sh",
        "-c",
        "jq --sort-keys . \"$1\" > \"$1.tmp\" && mv \"$1.tmp\" \"$1\"",
        "sh",
        "$FILE"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "prettier": {
      "command": [
        "prettier",
        "--write",
        "$FILE"
      ],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [
        ".css",
        ".html",
        ".js",
        ".json",
        ".jsonc",
        ".jsx",
        ".md",
        ".scss",
        ".ts",
        ".tsx",
        ".yaml",
        ".yml",
        ".svg"
      ]
    },
    "stylua": {
      "command": [
        "stylua",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "yq": {
      "command": [
        "yq",
        "-i",
        "-P",
        "sort_keys(..)",
        "$FILE"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "theme": "system"
}
